{
  "protocolVersion": 1,
  "id": "soma.somatic_core",
  "version": "1.0.0",
  "name": "somatic core",
  "description": "bounded continual learner: exact context store on a phi ladder of timescales (orders 1-3, 4 tokens to all-time) read by a learned network, mixed per context \u00b7 8k alphabet \u00b7 io2 \u00b7 nothing grows \u00b7 no attention, no window",
