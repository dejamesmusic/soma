  "sourceRoot": "source",
  "worker": "somatic_core/somatic_train_worker.py",
  "chatEntry": "somatic_core.runtime:SOMA",
  "runtimeModule": "somatic_core/runtime.py",
  "dependencies": "source/requirements.txt",
