{
  "protocolVersion": 1,
  "id": "soma.rma_v1",
  "version": "1.8.1",
  "name": "rma v1",
  "description": "residual metabolic aperture · 8k alphabet · directional temporal bands",
  "python": "/Library/Frameworks/Python.framework/Versions/3.11/bin/python3",
  "sourceRoot": "source",
  "worker": "soma_rma_v1/soma_train_worker.py",
  "chatEntry": "soma_rma_v1.runtime:SOMA",
  "runtimeModule": "soma_rma_v1/runtime.py",
  "dependencies": "source/requirements.txt",
  "capabilities": ["train", "chat", "evaluate", "fork", "stream"],
  "checkpoint": {
    "format": "soma-rma-v1-pytorch",
    "compatibility": "exact-runtime",
    "opens": ["1.6.0", "1.6.1", "1.6.2", "1.6.3", "1.6.4", "1.7.0", "1.8.0"],
    "cursorPolicy": "resume-saved",
    "lineage": true
  },
  "reporting": {
    "headline": {"key":"bpb","label":"bits per byte"},
    "stats": [
      {"key":"bps","label":"source bytes/s"},
      {"key":"updates","label":"updates"},
      {"key":"life_bytes","label":"source bytes"}
    ],
    "spectrum": {"key":"residual_excess","label":"residual excess by passband"}
  },
  "fields": [
    {"key":"corpus","label":"corpus","type":"file","value":"","group":"feed"},
    {"key":"save_path","label":"checkpoint path","type":"text","value":"","group":"output"},
    {"key":"checkpoint","label":"continue from","type":"file","value":"","group":"output"},
    {"key":"fork","label":"fork checkpoint","type":"boolean","value":"false","options":["false","true"],"group":"output"},
    {"key":"width","label":"temporal width","type":"integer","value":"256","options":["8","128","256","384","512","768","1024","1536","2048","3072","4096"],"group":"shape"},
    {"key":"bands","label":"temporal bands","type":"integer","value":"32","options":["4","16","24","32","48","64"],"group":"shape"},
    {"key":"cortex_width","label":"cortex width","type":"integer","value":"0","options":["0","256","512","1024","2048"],"group":"shape"},
    {"key":"cortex_depth","label":"cortex depth","type":"integer","value":"0","options":["0","1","2","3"],"group":"shape"},
    {"key":"readout_window","label":"pointer window","type":"integer","value":"256","options":["0","64","128","256","512","1024"],"group":"shape"},
    {"key":"source_gain","label":"source gain","type":"number","value":"0.3","group":"dynamics"},
    {"key":"cortex_rate","label":"cortex rate","type":"number","value":"1","options":["0.25","0.5","1"],"group":"dynamics"},
    {"key":"evidence_quantum","label":"batch","type":"integer","value":"256","group":"dynamics"},
    {"key":"decimation_stride_cap","label":"max traversal","type":"integer","value":"256","group":"dynamics"},
    {"key":"traversal_gain","label":"traversal gain","type":"number","value":"1","group":"dynamics"},
    {"key":"width_scaling","label":"width scaling","type":"number","value":"0.5","options":["0","0.25","0.5"],"absent":"0","group":"dynamics"},
    {"key":"epochs","label":"passes","type":"integer","value":"1","group":"feed"},
    {"key":"max_bytes","label":"max source bytes","type":"integer","value":"0","group":"feed"},
    {"key":"start_byte","label":"source byte","type":"integer","value":"0","group":"feed"},
    {"key":"dream_every_batches","label":"dream every batches","type":"integer","value":"64","group":"reporting"},
    {"key":"dream_length","label":"dream length","type":"integer","value":"128","group":"reporting"},
    {"key":"autosave_min","label":"autosave minutes","type":"integer","value":"30","group":"reporting"}
  ]
}
